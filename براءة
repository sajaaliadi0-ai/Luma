Step 3 — Call the API

const handleSubmit = async () => {
  setError('')
  if (ideaText.trim().length < 20) {
    setError('Please describe your idea in at least 20 characters.')
    return
  }
  try {
    setLoading(true)
    const response = await api.post('/api/blueprints', {
      title: ideaText.slice(0, 80),
      idea_text: ideaText.trim(),
      project_type: projectType,
      complexity: complexity,
      output_language: outputLanguage,
    })
    const blueprint = response.data.blueprint || response.data.data || response.data
    navigate(`/newblueprint2?id=${blueprint.id}`)
  } catch (err) {
    const message = err.response?.data?.message
    setError(message || 'Something went wrong. Please try again.')
  } finally {
    setLoading(false)
  }
}

Step 4 — Loading state on the button

<button onClick={handleSubmit} disabled={loading}>
  {loading ? 'Creating blueprint...' : 'Generate Blueprint'}
</button>

