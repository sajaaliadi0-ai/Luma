import { useSearchParams } from 'react-router-dom'
const [searchParams] = useSearchParams()
const blueprintId = searchParams.get('id')

Step 2 — Fetch blueprint metadata on mount

useEffect(() => {
  if (!blueprintId) return
  api.get(`/api/blueprints/${blueprintId}`).then(res => {
    const bp = res.data.blueprint || res.data
    setCurrentBlueprint(bp)
  })
}, [blueprintId])

Step 3 — Subscribe to SSE for live updates

useEffect(() => {
  if (!blueprintId) return
  const token = localStorage.getItem('token')
  const apiBase = import.meta.env.VITE_API_URL || 'http://localhost:3000'
  const sse = new EventSource(`${apiBase}/api/blueprints/${blueprintId}/events?token=${token}`)
  
  sse.onmessage = () => {
    // Refetch sections whenever an event arrives
    api.get(`/api/blueprints/${blueprintId}/sections`).then(r => {
      setSections(r.data.sections || r.data)
    })
  }
  
  sse.onerror = () => sse.close()
  return () => sse.close()
}, [blueprintId])

