/**
 * GET /api/blueprints/{id}/diagrams
 *
 * Get all diagrams belonging to the current blueprint.
 */
const fetchDiagrams = async () => {
  if (!blueprintId) {
    console.log("⏳ Waiting for blueprintId before fetching diagrams...");
    return;
  }

  try {
    setDiagramsLoading(true);
    setDiagramsError(null);

    console.log(
      "📊 Fetching diagrams for blueprint:",
      blueprintId
    );

    const response = await api.get(
      `/blueprints/${blueprintId}/diagrams`
    );

    console.log(
      "📊 Diagrams response:",
      response.data
    );

    const data = response.data;

    let diagramList = [];

    if (Array.isArray(data)) {
      diagramList = data;
    } else if (Array.isArray(data?.diagrams)) {
      diagramList = data.diagrams;
    } else if (Array.isArray(data?.data)) {
      diagramList = data.data;
    } else if (Array.isArray(data?.items)) {
      diagramList = data.items;
    }

    setDiagrams(diagramList);

    // Select first diagram automatically
    if (diagramList.length > 0) {
      setSelectedDiagram(diagramList[0]);
    } else {
      setSelectedDiagram(null);
    }

    return diagramList;

  } catch (error) {
    console.error(
      "❌ Failed to fetch diagrams:",
      error
    );

    if (error.response?.status === 401) {
      setDiagramsError(
        "Unauthorized. Please login again."
      );
    } else if (error.response?.status === 404) {
      setDiagramsError(
        "Blueprint not found."
      );
    } else {
      setDiagramsError(
        error.response?.data?.message ||
        error.response?.data?.error ||
        "Failed to load diagrams."
      );
    }

    return [];
  } finally {
    setDiagramsLoading(false);
  }
};


/**
 * POST /api/blueprints/{id}/diagrams
 *
 * Create a new diagram for the current blueprint.
 *
 * IMPORTANT:
 * The exact body fields depend on the schema shown in Swagger.
 */
const createDiagram = async (diagramData = {}) => {
  if (!blueprintId) {
    console.error(
      "❌ Cannot create diagram: blueprintId is missing."
    );
    return null;
  }

  try {
    setDiagramCreating(true);

    console.log(
      "➕ Creating diagram for blueprint:",
      blueprintId
    );

    console.log(
      "📦 Diagram payload:",
      diagramData
    );

    const response = await api.post(
      `/blueprints/${blueprintId}/diagrams`,
      diagramData
    );

    console.log(
      "✅ Diagram created:",
      response.data
    );

    const createdDiagram =
      response.data?.diagram ||
      response.data?.data ||
      response.data;

    if (createdDiagram) {
      setSelectedDiagram(createdDiagram);

      setDiagrams((previous) => [
        ...previous,
        createdDiagram,
      ]);
    }

    return createdDiagram;

  } catch (error) {
    console.error(
      "❌ Failed to create diagram:",
      error
    );

    if (error.response?.status === 400) {
      console.error(
        "Diagram validation error:",
        error.response?.data
      );
    } else if (error.response?.status === 401) {
      console.error(
        "Unauthorized while creating diagram."
      );
    } else if (error.response?.status === 404) {
      console.error(
        "Blueprint not found."
      );
    }

    throw error;

  } finally {
    setDiagramCreating(false);
  }
};


