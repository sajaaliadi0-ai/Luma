        "Unauthorized while fetching diagram."
      );
    } else if (error.response?.status === 404) {
      console.error(
        "Diagram not found."
      );
    }

    throw error;

  } finally {
    setDiagramLoading(false);
  }
};


/**
 * PATCH /api/diagrams/{id}
 *
 * Update an existing diagram.
 *
 * IMPORTANT:
 * The exact body fields depend on the Swagger schema.
 */
const updateDiagram = async (
  diagramId,
  diagramData = {}
) => {
  if (!diagramId) {
    console.error(
      "❌ Cannot update diagram: diagramId is missing."
    );
    return null;
  }

  try {
    setDiagramUpdating(true);

    console.log(
      "✏️ Updating diagram:",
      diagramId
    );

    console.log(
      "📦 Update payload:",
      diagramData
    );

    const response = await api.patch(
      `/diagrams/${diagramId}`,
      diagramData
    );

    console.log(
      "✅ Diagram updated:",
      response.data
    );

    const updatedDiagram =
      response.data?.diagram ||
      response.data?.data ||
      response.data;

    if (updatedDiagram) {
      setSelectedDiagram(updatedDiagram);

      setDiagrams((previous) =>
        previous.map((diagram) =>
          diagram?.id === diagramId
            ? updatedDiagram
            : diagram
        )
      );
    }

    return updatedDiagram;

  } catch (error) {
    console.error(
      "❌ Failed to update diagram:",
      error
    );

    if (error.response?.status === 400) {
      console.error(
        "Diagram validation error:",
        error.response?.data
      );
    } else if (error.response?.status === 401) {
      console.error(
        "Unauthorized while updating diagram."
      );
    } else if (error.response?.status === 404) {
      console.error(
        "Diagram not found."
      );
    }

    throw error;

  } finally {
    setDiagramUpdating(false);
  }
};


/**
 * DELETE /api/diagrams/{id}
 *
 * Delete an existing diagram.
 */
const deleteDiagram = async (diagramId) => {
  if (!diagramId) {
    console.error(
      "❌ Cannot delete diagram: diagramId is missing."
    );
    return false;
  }

  try {
    setDiagramDeleting(true);

    console.log(
      "🗑️ Deleting diagram:",
      diagramId
    );

    const response = await api.delete(
      `/diagrams/${diagramId}`
    );

    console.log(
      "✅ Diagram deleted:",
      response.data
    );

    // Remove it from local state
    setDiagrams((previous) =>
      previous.filter(
        (diagram) => diagram?.id !== diagramId
      )
    );

    // Clear selected diagram if it was deleted
    setSelectedDiagram((previous) =>
      previous?.id === diagramId
        ? null
        : previous
    );

    return true;

  } catch (error) {
    console.error(
      "❌ Failed to delete diagram:",
      error
    );

    if (error.response?.status === 401) {
      console.error(
        "Unauthorized while deleting diagram."
      );
    } else if (error.response?.status === 404) {
      console.error(
        "Diagram not found."
      );
    }

    throw error;

  } finally {
    setDiagramDeleting(false);
  }
};
