.blueprints-page {
  padding: 30px;
  background: #f8f7ff;
  min-height: 100vh;
  font-family: "Inter", sans-serif;
  color: #1f2937;
}


/* ================= HEADER ================= */

.blueprints-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 28px;
}


.blueprints-header h1 {
  font-size: 32px;
  font-weight: 700;
  margin: 0;
  color: #111827;
}


.blueprints-header p {
  margin-top: 8px;
  color: #6b7280;
  font-size: 15px;
}



.new-blueprint-btn {

  display: flex;
  align-items: center;
  gap: 8px;

  background: linear-gradient(
    135deg,
    #7c3aed,
    #9333ea
  );

  color: white;

  border: none;
  padding: 12px 20px;

  border-radius: 12px;

  font-size: 14px;
  font-weight: 600;

  cursor: pointer;

  transition: .3s;

}



.new-blueprint-btn:hover {

  transform: translateY(-2px);

  box-shadow:
  0 10px 25px rgba(124,58,237,.25);

}





/* ================= STAT CARDS ================= */


.stats-container {

  display:grid;

  grid-template-columns:
  repeat(4,1fr);

  gap:20px;

  margin-bottom:30px;

}



.stat-card {

  background:white;

  border-radius:18px;

  padding:22px;

  display:flex;

  align-items:center;

  gap:18px;


  border:1px solid #eee;


  box-shadow:
  0 8px 25px rgba(0,0,0,.04);

}



.stat-card span {

  color:#6b7280;

  font-size:14px;

}



.stat-card h2 {

  margin:8px 0 0;

  font-size:28px;

}




.stat-icon {

  width:52px;
  height:52px;

  border-radius:15px;

  display:flex;

  align-items:center;

  justify-content:center;

  font-size:24px;

}



.stat-icon.purple {

  background:#ede9fe;
  color:#7c3aed;

}



.stat-icon.green {

  background:#dcfce7;
  color:#16a34a;

}



.stat-icon.orange {

  background:#ffedd5;
  color:#ea580c;

}



.stat-icon.red {

  background:#fee2e2;
  color:#dc2626;

}






/* ================= TOOLBAR ================= */


.blueprint-toolbar {

  background:white;

  padding:20px;

  border-radius:18px;

  display:flex;

  justify-content:space-between;

  align-items:center;

  margin-bottom:20px;


  border:1px solid #eee;

}




.search-box {

  width:330px;

  display:flex;

  align-items:center;

  gap:10px;

  background:#f9fafb;

  padding:12px 15px;

  border-radius:12px;

  color:#9ca3af;

}



.search-box input {

  border:none;

  outline:none;

  background:transparent;

  width:100%;

  font-size:14px;

}




.tabs {

  display:flex;

  gap:8px;

}



.tabs button {

  border:none;

  background:#f3f4f6;

  padding:10px 18px;

  border-radius:10px;

  cursor:pointer;

  color:#6b7280;

  font-weight:500;

}



.tabs button:hover {

  background:#ede9fe;

  color:#7c3aed;

}




.tabs .active-tab {

  background:#7c3aed;

  color:white;

}








/* ================= TABLE ================= */


.blueprints-table-wrapper {

  background:white;

  border-radius:18px;

  overflow:hidden;

  border:1px solid #eee;

}



.blueprints-table {

  width:100%;

  border-collapse:collapse;

}




.blueprints-table th {

  text-align:left;

  padding:18px;

  font-size:13px;

  color:#6b7280;

  background:#fafafa;

}



.blueprints-table td {

  padding:18px;

  border-top:1px solid #f1f1f1;

  font-size:14px;

}




.blueprint-info {

  display:flex;

  align-items:center;

  gap:14px;

}



.blueprint-logo {

  width:42px;

  height:42px;

  border-radius:12px;

  background:
  linear-gradient(
  135deg,
  #8b5cf6,
  #c084fc
  );

  color:white;

  display:flex;

  align-items:center;

  justify-content:center;

  font-weight:700;

}



.blueprint-info h4 {

  margin:0;

  font-size:15px;

}



.blueprint-info p {

  margin:5px 0 0;

  color:#9ca3af;

  font-size:13px;

}





/* ================= STATUS ================= */


.status {

  padding:6px 12px;

  border-radius:20px;

  font-size:12px;

  font-weight:600;

}




.status.active {

  background:#dcfce7;

  color:#15803d;

}



.status.building {

  background:#fef3c7;

  color:#b45309;

}



.status.completed {

  background:#dbeafe;

  color:#2563eb;

}



.status.failed {

  background:#fee2e2;

  color:#dc2626;

}




.action-btn {

  border:none;

  background:#f3f4f6;

  width:35px;

  height:35px;

  border-radius:10px;

  cursor:pointer;

  display:flex;

  align-items:center;

  justify-content:center;

}





/* ================= PAGINATION ================= */


.pagination {

  margin-top:25px;

  display:flex;

  justify-content:flex-end;

  gap:10px;

  align-items:center;

}



.pagination span,
.pagination button {

  width:38px;

  height:38px;

  border-radius:10px;

  border:none;

  background:white;

  display:flex;

  align-items:center;

  justify-content:center;

  cursor:pointer;

}



.pagination .page-active {

  background:#7c3aed;

  color:white;

}






/* ================= RESPONSIVE ================= */


@media(max-width:1100px){


.stats-container{

grid-template-columns:
repeat(2,1fr);

}


.blueprint-toolbar{

flex-direction:column;

gap:15px;

align-items:stretch;

}


.search-box{

width:auto;

}


}



@media(max-width:700px){


.blueprints-page{

padding:15px;

}


.blueprints-header{

flex-direction:column;

align-items:flex-start;

gap:15px;

}


.stats-container{

grid-template-columns:1fr;

}



.blueprints-table-wrapper{

overflow-x:auto;

}


}

.dashboard-layout {

display:flex;

}


.page-content {

margin-left:250px;

width:calc(100% - 250px);

min-height:100vh;

}

.modal-overlay {

position:fixed;

inset:0;

background:rgba(0,0,0,.35);

display:flex;

align-items:center;

justify-content:center;

z-index:200;

}


.modal {

background:white;

padding:25px;

border-radius:18px;

width:400px;

display:flex;

flex-direction:column;

gap:15px;

}


.modal input {

padding:12px;

border:1px solid #ddd;

border-radius:10px;

}


.modal button {

padding:10px;

border:none;

border-radius:10px;

background:#7c3aed;

color:white;

cursor:pointer;

}
